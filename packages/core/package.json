{
  "name": "@project-sothoth/core",
  "version": "0.1.0",
  "description": "Pure deterministic compilation primitives for Sothoth.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./canonical-json": {
      "types": "./dist/canonical-json.d.ts",
      "import": "./dist/canonical-json.js"
    },
    "./digest": {
      "types": "./dist/digests.d.ts",
      "import": "./dist/digests.js"
    },
    "./compile": {
      "types": "./dist/compile.d.ts",
      "import": "./dist/compile.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js"
    },
    "./outcome": {
      "types": "./dist/outcome.d.ts",
      "import": "./dist/outcome.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": { "access": "public", "provenance": true },
  "repository": { "type": "git", "url": "git+https://github.com/Phenol1145/sothoth.git", "directory": "packages/core" },
  "engines": { "node": ">=22.14.0" },
  "dependencies": { "@project-sothoth/contracts": "0.1.0" }
}
